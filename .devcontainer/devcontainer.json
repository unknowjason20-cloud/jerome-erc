{
  "name": "gflow-cli",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop (noVNC)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
